# Native dual cards persist during construction and refresh cooldown.
template hbe_af_panel_surface {
background = { using = color_white_texture color = { 0.075 0.085 0.083 1 } }
background = { using = overlay_paper_03 alpha = 0.10 }
background = { using = tile_frame_squared_texture modify_texture = { using = color_new_gold_texture } }
}
template hbe_af_card_surface {
background = { using = color_white_texture color = { 0.095 0.090 0.075 1 } }
background = { using = overlay_paper_03 alpha = 0.10 }
background = { using = tile_frame_squared_texture modify_texture = { using = color_new_gold_texture } alpha = 0.72 }
}
types HbeLocalAffairs {
type hbe_af_overlay = widget { name = "hbe_local_affairs" size = { 100% 100% } alwaystransparent = yes
visible = "[And(Not(IsPauseMenuShown),GetScriptedGui('hbe_af_ui_access').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
button_regular = { parentanchor = bottom|right widgetanchor = bottom|right position = { -24 -96 } size = { 130 30 } text = "HBE_AF_OPEN"
onclick = "[GetScriptedGui('hbe_af_ui_prepare').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetVariableSystem.Toggle('hbe_af_panel_open')]" }
window = { name = "hbe_af_window" size = { 840 628 } position = { 0 0 } parentanchor = center widgetanchor = center movable = yes using = hbe_af_panel_surface
visible = "[GetVariableSystem.Exists('hbe_af_panel_open')]"
window_header_alt = { size = { 840 42 } blockoverride "header_text_object" { widget = { size = { 0 0 } } } }
text_single = { position = { 0 5 } size = { 840 32 } autoresize = no align = center using = Font_Type_Headers fontsize = 24 text = "HBE_AF_TITLE" color = { 0.94 0.90 0.80 1 } }
widget = { position = { -78 8 } parentanchor = top|right widgetanchor = top|right size = { 30 30 } AutomationCheckbox = {
down = "[GetScriptedGui('hbe_af_ui_auto_state').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
tooltip = "HBE_AF_COG_TT"

action_tooltip = { click_type = right title = "HBE_AF_AUTO_TOGGLE" on_action = "[GetScriptedGui('hbe_af_ui_auto').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
tooltipwidget = { BasicFunctionalTooltip = {} }
} }
button_close = { position = { -10 8 } parentanchor = top|right widgetanchor = top|right onclick = "[GetVariableSystem.Toggle('hbe_af_panel_open')]" }
text_multi = { position = { 32 53 } size = { 776 30 }
autoresize = no align = center text = "HBE_AF_PANEL_STATUS" using = Font_Type_Headers fontsize = 16 color = { 0.94 0.90 0.80 1 } }
widget = { position = { 235 87 } size = { 180 30 }
checkbox_round_alt = { down = "[Not(Or(And(Not(GetScriptedGui('hbe_af_ui_running').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)),GetVariableSystem.Exists('hbe_af_preview_large')),And(GetScriptedGui('hbe_af_ui_running').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End),EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('hbe_af_tier').GetValue, '(CFixedPoint)2'))))]" enabled = "[And(GetScriptedGui('hbe_af_ui_ready').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End),Not(Not(Or(And(Not(GetScriptedGui('hbe_af_ui_running').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)),GetVariableSystem.Exists('hbe_af_preview_large')),And(GetScriptedGui('hbe_af_ui_running').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End),EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('hbe_af_tier').GetValue, '(CFixedPoint)2'))))))]" onclick = "[GetVariableSystem.Toggle('hbe_af_preview_large')]" }
text_single = { position = { 38 0 } size = { 140 30 } autoresize = no using = Font_Type_Headers fontsize = 16 align = left|nobaseline text = "HBE_AF_SMALL"  } }widget = { position = { 425 87 } size = { 180 30 }
checkbox_round_alt = { down = "[Or(And(Not(GetScriptedGui('hbe_af_ui_running').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)),GetVariableSystem.Exists('hbe_af_preview_large')),And(GetScriptedGui('hbe_af_ui_running').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End),EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('hbe_af_tier').GetValue, '(CFixedPoint)2')))]" enabled = "[And(GetScriptedGui('hbe_af_ui_ready').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End),Not(Or(And(Not(GetScriptedGui('hbe_af_ui_running').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)),GetVariableSystem.Exists('hbe_af_preview_large')),And(GetScriptedGui('hbe_af_ui_running').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End),EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('hbe_af_tier').GetValue, '(CFixedPoint)2')))))]" onclick = "[GetVariableSystem.Toggle('hbe_af_preview_large')]" }
text_single = { position = { 38 0 } size = { 140 30 } autoresize = no using = Font_Type_Headers fontsize = 16 align = left|nobaseline text = "HBE_AF_LARGE" tooltip = "HBE_AF_LARGE_TT" } }
widget = { position = { 32 124 } size = { 376 420 } using = hbe_af_card_surface widget = { name = "hbe_af_illustrated_header" position = { 2 2 } size = { 372 106 } alwaystransparent = yes
background = { texture = "gfx/interface/hbe/local_affairs/national_header.dds"
modify_texture = { texture = "gfx/interface/component_masks/mask_fade_vertical.dds" blend_mode = alphamultiply } }
background = { using = color_black_texture alpha = 0.66
modify_texture = { texture = "gfx/interface/component_masks/mask_fade_horizontal_right.dds" blend_mode = alphamultiply } }
}
