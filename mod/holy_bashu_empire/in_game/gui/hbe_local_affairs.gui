type hbe_af_alert = button {
visible = "[GetScriptedGui('hbe_af_ui_available').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
using = alert_banner_setup using = green_alert
blockoverride "icon_texture" { texture = "gfx/interface/icons/alerts_icons/decisions.dds" }
blockoverride "alert_is_new_padding_visible" { visible = no }
tooltip = "HBE_AF_NOTICE_TT"
action_tooltip = { title = "HBE_AF_NOTICE" on_action = "[GetScriptedGui('hbe_af_ui_prepare').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" on_action = "[GetVariableSystem.Set('hbe_af_panel_open','yes')]" }
action_tooltip = { click_type = right title = "HBE_AF_NOTICE_HIDE" on_action = "[GetScriptedGui('hbe_af_ui_dismiss_notice').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
tooltipwidget = { BasicFunctionalTooltip = {} }
}
}