# Reuses vanilla situation blocks and two_countries_header_template.
# No GetGagMemberItems/GetCountryGuelphsProgress: those are engine-bound to Italy.
situation_panel = {
 blockoverride "situation_header_left" {
  vbox = { hbox = { spacing = 5 icon = { size = { 28 28 } texture = "gfx/interface/icons/international_organizations/hbe_common_party.dds" } text_single = { text = "HBE_COMMON_LEADER" } }
   hbox = { datacontext = "[GetUniqueInternationalOrganization('hbe_common_party').GetLeaderCountry]" spacing = 4
    country_flag_small = {} text_single = { text = "[Country.GetName]" } }
  }
 }
 blockoverride "situation_header_right" {
  vbox = { hbox = { spacing = 5 icon = { size = { 28 28 } texture = "gfx/interface/icons/international_organizations/hbe_local_party.dds" } text_single = { text = "HBE_LOCAL_LEADER" } }
   hbox = { datacontext = "[GetUniqueInternationalOrganization('hbe_local_party').GetLeaderCountry]" spacing = 4
    country_flag_small = {} text_single = { text = "[Country.GetName]" } }
  }
 }
 blockoverride "situation_panel_image" {
  using = two_countries_header_template
  blockoverride "two_countries_header_image" { background = { texture = "gfx/interface/hbe/panels/hbe_feast_two_parties_v021.dds" texture_density = 2 spriteType = stretched spriteborder = { 0 0 } } }
  blockoverride "FirstCountryContext" { datacontext = "[GetUniqueInternationalOrganization('hbe_common_party').GetLeaderCountry]" }
  blockoverride "SecondCountryContext" { datacontext = "[GetUniqueInternationalOrganization('hbe_local_party').GetLeaderCountry]" }
  blockoverride "first_character_portrait_anchor" { parentanchor = bottom|left }
  blockoverride "second_character_portrait_anchor" { parentanchor = bottom|right }
  blockoverride "character_religion_visibility" { visible = no }
  blockoverride "character_name_maximumsize" { maximumsize = { 270 -1 } }
  blockoverride "character_role" { datacontext = "[Character.GetRuledCountry]" country_flag_small = {} }
 }
 blockoverride "situation_subheader_content" {}
 blockoverride "situation_panel_main_maximumsize" { minimumsize = { -1 320 } }
 blockoverride "situation_panel_main_actions" {
 vbox = { size = { 480 -1 } spacing = 5
 text_multi = { size = { 480 62 } autoresize = no align = left|top text = "HBE_FEAST_ACTION_HELP" }
targetted_button_regular = { size = { 480 32 } text = "hbe_feast_fund_action"
 enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
 scripted_action_tooltip = { click_type = left click_mode = single action_name = "hbe_feast_fund_action"
  actor = "[Player]" parameter = { parameter_name = "recipient" parameter_value = "[GetSituationByKey('hbe_banquet')]" }
 }
 tooltipwidget = { BasicFunctionalTooltip = {} }
}
targetted_button_regular = { size = { 480 32 } text = "hbe_feast_common_action"
 enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
 scripted_action_tooltip = { click_type = left click_mode = single action_name = "hbe_feast_common_action"
  actor = "[Player]" parameter = { parameter_name = "recipient" parameter_value = "[GetSituationByKey('hbe_banquet')]" }
 }
 tooltipwidget = { BasicFunctionalTooltip = {} }
}
targetted_button_regular = { size = { 480 32 } text = "hbe_feast_local_action"
 enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
 scripted_action_tooltip = { click_type = left click_mode = single action_name = "hbe_feast_local_action"
  actor = "[Player]" parameter = { parameter_name = "recipient" parameter_value = "[GetSituationByKey('hbe_banquet')]" }
 }
 tooltipwidget = { BasicFunctionalTooltip = {} }
}
 }
}
 blockoverride "situation_panel_main_content" {
  vbox = { minimumsize = { 480 -1 } maximumsize = { 480 -1 } spacing = 8
  text_multi = { size = { 480 46 } autoresize = no align = left|top text = "HBE_FEAST_STATUS" }
  widget = { size = { 480 18 }
   barchart = { size = { 480 16 }
    barslice = { texture = "gfx/interface/progressbars/progress_bar_whiteish.dds" color = { 0.60 0.22 0.16 1 }
     value = "[FixedPointToFloat(GetUniqueInternationalOrganization('hbe_common_party').MakeScope.GetVariable('hbe_party_points').GetValue)]" }
    barslice = { texture = "gfx/interface/progressbars/progress_bar_whiteish.dds" color = { 0.18 0.38 0.56 1 }
     value = "[FixedPointToFloat(GetUniqueInternationalOrganization('hbe_local_party').MakeScope.GetVariable('hbe_party_points').GetValue)]" }
   }
  }
  text_multi = { size = { 480 64 } autoresize = no align = left|top text = "HBE_FEAST_GUIDE" }
  text_multi = { size = { 480 94 } autoresize = no align = left|top text = "HBE_FEAST_REWARDS" }
 text_multi = { size = { 480 24 } autoresize = no visible = "[IsPlayerValid]" text = "HBE_FEAST_LAST_DIVIDEND" }
  hbox = { size = { 480 312 } spacing = 12
vbox = { size = { 234 312 } minimumsize = { 234 312 } maximumsize = { 234 312 } spacing = 4
 text_multi = { size = { 234 64 } autoresize = no align = left|top text = "HBE_FEAST_COMMON" }
 widget = { size = { 210 24 }
  text_single = { position = { 37 0 } size = { 123 24 } autoresize = no align = left|nobaseline text = "HBE_FEAST_MEMBER_NAME" }
  text_single = { position = { 164 0 } size = { 42 24 } autoresize = no align = right|nobaseline text = "HBE_FEAST_MEMBER_POINTS" }
 }
 scrollarea = { size = { 234 216 } scrollbarpolicy_horizontal = always_off autoresizeviewport = yes
  viewportwidget = { widget = { scissor = yes } }
  scrollbar_vertical = { using = Scrollbar_Vertical }
  scrollwidget = { fixedgridbox = {
   size = { 210 -1 } minimumsize = { 210 -1 } maximumsize = { 210 -1 }
   addrow = 30 addcolumn = 210 datamodel_reuse_widgets = yes
   datamodel = "[GetUniqueInternationalOrganization('hbe_common_party').GetMembers]"
   item = { widget = { size = { 210 30 } tooltip = "HBE_AF_MEMBER_CONTRIBUTION_TT"
    background = { using = color_whiteish_texture alpha = 0.08 }
    country_flag_very_small = { position = { 3 5 } size = { 30 20 } tooltip = "HBE_AF_MEMBER_CONTRIBUTION_TT" }
    text_single = { position = { 37 2 } size = { 123 26 } maximumsize = { 123 26 } autoresize = no align = left|nobaseline text = "[Country.GetName]" }
    text_single = { position = { 164 2 } size = { 42 26 } maximumsize = { 42 26 } autoresize = no align = right|nobaseline text = "[Country.MakeScope.GetVariable('hbe_feast_points').GetValue|2]" }
   } }
  } }


















 }
}
vbox = { size = { 234 312 } minimumsize = { 234 312 } maximumsize = { 234 312 } spacing = 4
 text_multi = { size = { 234 64 } autoresize = no align = left|top text = "HBE_FEAST_LOCAL" }
 widget = { size = { 210 24 }
  text_single = { position = { 37 0 } size = { 123 24 } autoresize = no align = left|nobaseline text = "HBE_FEAST_MEMBER_NAME" }
  text_single = { position = { 164 0 } size = { 42 24 } autoresize = no align = right|nobaseline text = "HBE_FEAST_MEMBER_POINTS" }
 }
 scrollarea = { size = { 234 216 } scrollbarpolicy_horizontal = always_off autoresizeviewport = yes
  viewportwidget = { widget = { scissor = yes } }
  scrollbar_vertical = { using = Scrollbar_Vertical }
  scrollwidget = { fixedgridbox = {
   size = { 210 -1 } minimumsize = { 210 -1 } maximumsize = { 210 -1 }
   addrow = 30 addcolumn = 210 datamodel_reuse_widgets = yes
   datamodel = "[GetUniqueInternationalOrganization('hbe_local_party').GetMembers]"
   item = { widget = { size = { 210 30 } tooltip = "HBE_AF_MEMBER_CONTRIBUTION_TT"
    background = { using = color_whiteish_texture alpha = 0.08 }
    country_flag_very_small = { position = { 3 5 } size = { 30 20 } tooltip = "HBE_AF_MEMBER_CONTRIBUTION_TT" }
    text_single = { position = { 37 2 } size = { 123 26 } maximumsize = { 123 26 } autoresize = no align = left|nobaseline text = "[Country.GetName]" }
    text_single = { position = { 164 2 } size = { 42 26 } maximumsize = { 42 26 } autoresize = no align = right|nobaseline text = "[Country.MakeScope.GetVariable('hbe_feast_points').GetValue|2]" }
   } }
  } }


















 }
}
  }
  }
 }
}
