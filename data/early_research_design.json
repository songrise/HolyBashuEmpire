  "military": [
    {"region":"chengdu_plain","name":"渠乡习射","english":"Canal Village Crossbow Training","unit":"hbe_canal_crossbow","buildings":[],"description":"渠口各乡轮派壮丁习射，弩具与箭料分册保管。守堰者依水次轮换，农忙时仍须回田，不再把织坊的名册当作军册。"},
    {"region":"southern_salt_wine","name":"井灶护运法","english":"Salt Convoy Guard Ordinance","unit":"hbe_salt_guard","buildings":[],"description":"井户与运盐人议定护送的路段，兵器、粮料与误期赔付各记一栏。护运者按程交接，盐场的产额与军中的点名从此分开核算。"},
    {"region":"eastern_river","name":"江岸编伍","english":"Riverbank Muster Rolls","unit":"hbe_river_garrison","buildings":[],"description":"沿江寨户按泊口编伍，守夜、巡岸与船上接应各有班次。船帮仍照常转运，寨兵却须另领粮械，不因船货增多便临时添派乡丁。"},
    {"region":"northern_shudao","name":"关隘轮戍法","english":"Mountain Pass Rotation Ordinance","unit":"hbe_pass_rotation","buildings":["hbe_plank_fort"],"description":"驿堡把到岗和归乡的日期分别登记，关军依册交接器械与粮额。道路可以通商，守关的轮次却须另有军令，不再混入驿夫的脚程。"},
    {"region":"central_hills","name":"义仓团练约","english":"Granary Militia Compact","unit":"hbe_granary_militia","buildings":[],"description":"仓社议定守仓与护田的班次，抽练者领取明列的粮额。丰年仍以耕作为本，遇警方按册集结；开仓赈借不再兼作征兵的口令。"},
    {"region":"western_tea_horse","name":"茶路护骑法","english":"Tea Route Cavalry Ordinance","unit":"hbe_tea_riders","buildings":["hbe_guide_station"],"description":"商队与护骑在山口验过驮具，按程分领马料与护送凭据。向导负责择路，骑手负责警戒，交割场的茶引不再代替军中的点验。"},
    {"region":"southwestern_valleys","name":"联寨编伍","english":"Allied Valley Muster Rolls","unit":"hbe_valley_soldiers","buildings":["hbe_covenant_stockade"],"description":"各寨把出人的数额和归还的期限写入共同军册，留守者接续照料田畜。谷市的买卖仍依旧约，驻防则另认粮额与轮替，不把盟约当作无期征令。"}
